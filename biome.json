{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!build",
			"!build-node",
			"!.svelte-kit",
			"!coverage",
			"!static",
			"!**/dist",
			"!**/*.yaml",
			"!**/*.yml",
			"!CHANGELOG.md"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": { "quoteStyle": "double", "trailingCommas": "all" }
	},
	"css": { "formatter": { "quoteStyle": "double" } },
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"indentScriptAndStyle": true,
			"selfCloseVoidElements": "always"
		}
	},
	"markdown": {
		"formatter": {
			"proseWrap": "always",
			"indentStyle": "space",
			"indentWidth": 2
		}
	},
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true }
}
